# Synthetic HTTPS-only fixture. NEVER deploy or serve publicly.
# This fixture is bound to local loopback and disables all automatic PKI/ACME.
# A test script supplies an ephemeral OpenSSL-generated certificate and key.
{
    admin off
    auto_https off
}
https://localhost:18443 {
    bind 127.0.0.1
    tls {$GC_TEST_TLS_CERT} {$GC_TEST_TLS_KEY}
    reverse_proxy 127.0.0.1:7689
}
