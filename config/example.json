{
  "schema": "goreecloud-gateway-config/v1",
  "trusted_proxies": [],
  "services": [
    {
      "id": "example-service",
      "name": "Example Service",
      "backend_ids": ["example-backend"]
    }
  ],
  "routes": [
    {
      "id": "example-private-route",
      "service_id": "example-service",
      "hostname": "example.goreecloud.com",
      "path_prefix": "/",
      "methods": ["GET", "HEAD"],
      "exposure": "private",
      "allowed_client_cidrs": ["100.64.0.0/10"],
      "enabled": false,
      "tls": {
        "mode": "required",
        "certificate_profile": "default-private"
      }
    }
  ],
  "backends": [
    {
      "id": "example-backend",
      "url": "http://127.0.0.1:8080",
      "enabled": true,
      "health_path": "/health"
    }
  ],
  "certificate_profiles": [
    {
      "id": "default-private",
      "certificate_file": "/run/goreecloud-gateway/tls/default-private.crt",
      "private_key_file": "/run/goreecloud-gateway/tls/default-private.key",
      "enabled": false
    }
  ]
}
