{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/gateway/config/v1",
  "title": "GoreeCloud Gateway Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "services", "routes", "backends"],
  "properties": {
    "schema": {"const": "goreecloud-gateway-config/v1"},
    "trusted_proxies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "backend_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "backend_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hostname", "path_prefix", "exposure", "enabled", "tls"],
        "allOf": [{
          "if": {"properties": {"action": {"const": "static_response"}}, "required": ["action"]},
          "then": {"required": ["static_response"], "not": {"anyOf": [{"required": ["service_id"]}, {"required": ["proxy_response_encoding"]}]}},
          "else": {"required": ["service_id"], "not": {"anyOf": [{"required": ["static_response"]}, {"required": ["response_encoding"]}]}}
        }],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "action": {"enum": ["reverse_proxy", "static_response"]},
          "service_id": {"$ref": "#/$defs/id"},
          "static_response": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status_code"],
            "properties": {
              "status_code": {"type": "integer", "minimum": 200, "maximum": 599},
              "body": {"type": "string", "maxLength": 16384}
            }
          },
          "response_encoding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["formats"],
            "properties": {
              "formats": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["zstd", "gzip"]}},
              "minimum_length": {"type": "integer", "minimum": 0, "maximum": 65536}
            }
          },
          "proxy_response_encoding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["formats"],
            "allOf": [{
              "if": {"properties": {"allow_unknown_length": {"const": true}}, "required": ["allow_unknown_length"]},
              "then": {"properties": {"minimum_length": {"const": 0}}, "required": ["minimum_length"]}
            }],
            "properties": {
              "formats": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["zstd", "gzip"]}},
              "minimum_length": {"type": "integer", "minimum": 0, "maximum": 65536},
              "allow_unknown_length": {"type": "boolean"}
            }
          },
          "hostname": {"type": "string", "minLength": 1, "maxLength": 253},
          "path_prefix": {"type": "string", "pattern": "^/"},
          "methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]}},
          "exposure": {"enum": ["internal", "private", "restricted-public", "public"]},
          "response_headers": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {"type": "string", "maxLength": 4096}
          },
          "enabled": {"type": "boolean"},
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["required", "disabled"]},
              "certificate_profile": {"$ref": "#/$defs/id"}
            }
          }
        }
      }
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "enabled"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "url": {"type": "string", "pattern": "^https?://"},
          "enabled": {"type": "boolean"},
          "health_path": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "certificate_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "certificate_file", "private_key_file", "enabled"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "certificate_file": {"type": "string", "minLength": 1, "maxLength": 4096},
          "private_key_file": {"type": "string", "minLength": 1, "maxLength": 4096},
          "enabled": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
  }
}
