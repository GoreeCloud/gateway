# Test-only local TLS termination for GoreeCloud Gateway Web and Android API.
# DO NOT deploy directly; this creates an ephemeral local CA and only binds loopback.
# No Internet DNS, ACME, Porkbun credentials, privileged ports or external routes.
{
    admin off
    auto_https disable_redirects
}
https://localhost:18443 {
    bind 127.0.0.1
    tls internal
    reverse_proxy 127.0.0.1:7689
}
