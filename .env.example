# Required outside demo mode. Use a long, independently generated secret (32+ chars).
GATEWAY_ACCESS_TOKEN=
# Loopback-only listener. Put an authenticated HTTPS reverse proxy in front of it.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3088
CADDY_ADMIN_URL=http://127.0.0.1:2019
# Set to the exact public HTTPS origin when behind a trusted reverse proxy.
# GATEWAY_PUBLIC_ORIGIN=https://gateway.example.com
# Opt in explicitly; by default this gateway cannot apply Caddy changes.
GATEWAY_ALLOW_APPLY=0
# Local-only, synthetic-data demo; mutually exclusive with live admin API access.
GATEWAY_DEMO=0
# Optional private directory for pre-apply snapshots (permissions 0700).
# GATEWAY_BACKUP_DIR=/var/lib/goreecloud-gateway/backups
